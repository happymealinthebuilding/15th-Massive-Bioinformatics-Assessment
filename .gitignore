# --- Raw and intermediate sequencing data (large, regenerable, never belongs in git) ---
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bam.csi
*.bam.bai
*.sam
*.paf

# --- Reference/BLAST databases pulled at runtime (regenerated by the notebook/script) ---
dbs/
*.fasta.n*
*.ndb
*.nhr
*.nin
*.nog
*.nos
*.not
*.nsq
*.ntf
*.nto
16S_ribosomal_RNA*

# --- Assembly and pipeline outputs (regenerated by re-running the pipeline) ---
results/
flye_asm/
kleborate_out/
*.gfa
*.gv

# --- Jupyter / Colab housekeeping ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp

