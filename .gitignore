# --- Raw and intermediate sequencing data (large, regenerable, never belongs in git) ---
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.bam
*.bam.csi
*.bam.bai
*.sam
*.paf

# --- Reference/BLAST databases pulled at runtime (regenerated by the notebook/script) ---
dbs/
*.fasta.n*
*.ndb
*.nhr
*.nin
*.nog
*.nos
*.not
*.nsq
*.ntf
*.nto
16S_ribosomal_RNA*

# --- Pipeline outputs ---
# NOTE: results/ in this repo is a *curated* set of final outputs (final assembly, summary
# tables, logs, species-ID results) checked in deliberately for reviewers to verify claims
# against without re-running the ~2hr Flye assembly. It is NOT excluded below.
# What IS excluded: Flye's disposable intermediate working directories (only relevant if you
# re-run the pipeline yourself — these regenerate under flye_asm/ and are never worth keeping).
flye_asm/00-assembly/
flye_asm/10-consensus/
flye_asm/20-repeat/
flye_asm/30-contigger/
flye_asm/40-polishing/

# --- Jupyter / Colab housekeeping ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp

# --- Keep these even though they'd otherwise match patterns above ---
!code/run_pipeline.sh
!code/unknown_isolate_analysis.ipynb
!results/reads_vs_card.paf